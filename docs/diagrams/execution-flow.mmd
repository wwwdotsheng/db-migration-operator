%% 一次迁移的执行流程（重构后：先建 Adapter，再取版本，再过 Checker 门禁）
%% 源文件：docs/diagrams/execution-flow.mmd
%%
%% 注意 1：online 分支（spec.online）是 experiment 分支上的实验代码，未纳入主线，图中不画。
%% 注意 2：当前代码判断「要不要预演」只看 Condition == True，未比对 metadata.generation；
%%          spec 修改后旧预演结论会被复用，这是已知缺口（对应 E5 的修复点）。
%% 注意 3：「return err」的路径交给 controller-runtime 做指数退避；
%%         「return nil」的路径只写状态，等待人工修复 spec 或外部条件变化。

flowchart TD
    A["CR 提交（kubectl apply）"] --> B["Reconcile：读取 SchemaMigration"]
    B --> C{"changeType 合法？"}
    C -->|"否"| F1["Phase=Failed + Event InvalidChangeType"]
    C -->|"是"| D{"phase ∈ Init/Applying/Blocked？"}
    D -->|"否（Done/Failed）"| E0["直接返回，不改状态"]
    D -->|"是"| P["prepareDatabase：建立数据库通道 + 版本门禁"]

    subgraph PDB["prepareDatabase"]
        P --> P1["ConfigManager.Parse(driverConfig)"]
        P1 -->|"失败"| PF1["Failed：ErrNotParseDriverConfig"]
        P1 --> P2["SecretResolver 读取密码"]
        P2 -->|"NotFound"| PB1["Blocked：等 Secret 出现"]
        P2 -->|"Unauthorized"| PF2["Failed：ErrUnauthorizedSecret"]
        P2 --> P3["cfg.BuildDSN(password)"]
        P3 --> P4["AdapterManager.New(driver, dsn) → Persistent"]
        P4 -->|"未知 driver"| PF3["Failed：ErrNoAdapterForDriver"]
        P4 --> P5["Persistent.GetServerVersion(ctx) → raw"]
        P5 -->|"错误"| PF4["关闭连接 + Failed"]
        P5 --> P6["CheckerManager.Check(driver, raw) → normalized, ok"]
        P6 -->|"解析错误"| PF4
        P6 -->|"不满足范围"| PF5["关闭连接 + Failed：version not satisfied"]
        P6 -->|"ok"| P7["返回 Persistent / Config / serverVersion"]
    end

    P7 --> CL["defer Persistent.Close(ctx)"]
    CL --> G{"声明了 beforeVersion？"}
    G -->|"是"| G1{"账本中 beforeVersion == Done？"}
    G -->|"否"| S{"ShadowValidated == True？"}
    G1 -->|"否"| B1["Condition=Blocked + Phase=Blocked"]
    G1 -->|"是"| S

    S -->|"否"| S1["shadowValidate：创建/观察影子 Job"]
    S -->|"是"| AP["applyMigration"]
    S1 -->|"Job 运行中"| S2["等待 Job 变化"]
    S1 -->|"失败"| SF["Condition=False + Phase=Failed"]
    S1 -->|"成功"| S3["Condition=True（ValidationPassed）"]
    S3 --> AP

    AP --> A1["persistent.Init()：建账本表"]
    A1 --> A2{"账本中 version 状态"}
    A2 -->|"Done"| A3["账本已是 Done（幂等跳过）"]
    A2 -->|"Failed"| A4["账本 Failed→Applying"]
    A2 -->|"不存在"| A5["插入 Applying"]
    A2 -->|"Applying"| A6["继续执行"]
    A3 --> A10["patchStatus Done + Event 迁移完成"]
    A4 --> A6
    A5 --> A6
    A6 --> A7{"再次检查 beforeVersion"}
    A7 -->|"不满足"| B1
    A7 -->|"满足"| A8["逐条 ExecSql；1060/1061/1091 视为已达成跳过"]
    A8 -->|"失败"| AF["Failed + applied N lines"]
    A8 --> A9["账本 Applying→Done"]
    A9 --> A10

    PB1 -->|"RequeueAfter 2min"| B
    B1 -->|"RequeueAfter 10s"| B
    S2 -->|"RequeueAfter 10s"| B

    F1 --> END0["return nil（不重试）"]
    PF1 --> END0
    PF2 --> END0
    PF3 --> END0
    SF --> END0
    E0 --> END0
    A10 --> END0
    AF --> END1["return err（退避重试）"]
    PF4 --> END1
    PF5 --> END1
