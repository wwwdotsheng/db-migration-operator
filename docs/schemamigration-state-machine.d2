vars: {
  d2-config: {
    theme-id: 0
    layout-engine: dagre
  }
}

direction: right

Init: "Init\n(phase 为空, 新建 CR)"
Applying: "Applying"
Blocked: "Blocked\n(等前置版本 / 等 Secret)"
Done: "Done ✅\n终态"
Failed: "Failed ❌\n终态"

Init -> Applying: "首次 reconcile\n账本写入 status='applying'"

Applying -> Applying: "连接失败等瞬态错误\nreturn err 退避重试\n状态保持不变"

Applying -> Done: "ApplySql 全部成功"

Applying -> Done: "幂等命中\n账本已是 done\n跳过执行只补状态"

Applying -> Blocked: "beforeVersion 未达成\n或 Secret 不存在"

Blocked -> Applying: "前置版本转为 Done\njudgeBlock 通过\n发 BlockCleared 事件"

Applying -> Failed: "driverConfig 解析失败\nSecret 无权限\nApplySql 执行失败"

Done -> Done: "终态: 直接 return\n不再执行"
Failed -> Failed: "终态: 直接 return\n需人工处理"
